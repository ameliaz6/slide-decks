---
import DeckLayout from "../../layouts/DeckLayout.astro";
import DeckSlide from "../../components/DeckSlide.astro";

const gaugeColors = [
    "#ed5a5a",
    "#ed6652",
    "#ed754c",
    "#ee8548",
    "#ee9647",
    "#efa748",
    "#efb94d",
    "#eaca50",
    "#d8d04f",
    "#c2d44f",
    "#a9d451",
    "#90d153",
    "#78cd55",
    "#61c957",
    "#4fc45b",
];

const gaugeSegments = gaugeColors.map((color, index) => {
    const startAngle = (180 + index * 12 + 2) * (Math.PI / 180);
    const endAngle = startAngle + 8 * (Math.PI / 180);
    const radius = 370;
    const centerX = 800;
    const centerY = 650;
    const startX = centerX + radius * Math.cos(startAngle);
    const startY = centerY + radius * Math.sin(startAngle);
    const endX = centerX + radius * Math.cos(endAngle);
    const endY = centerY + radius * Math.sin(endAngle);

    return {
        color,
        path: `M ${startX.toFixed(2)} ${startY.toFixed(2)} A ${radius} ${radius} 0 0 1 ${endX.toFixed(2)} ${endY.toFixed(2)}`,
    };
});
---

<DeckLayout title="Week 4 | Platforms">
    <DeckSlide class="title-slide" orbit>
        <div class="automation-copy week4-cover-copy">
            <p class="automation-eyebrow week4-eyebrow">Week 4</p>
            <h1>Platforms</h1>
            <p class="automation-subtitle">Building modern infrastructure</p>
            <p class="week4-byline">
                <span>By the Achievers</span>
                Amelia · Jack · Sophia · Ryan
            </p>
        </div>
    </DeckSlide>

    <DeckSlide class="achievometer-slide">
        <div class="achievometer-copy">
            <p class="automation-eyebrow">Team progress</p>
            <h2>The Achievometer</h2>
            <p>Celebrating the steps that move us forward</p>
        </div>

        <svg
            class="achievometer-gauge"
            viewBox="0 0 1600 800"
            role="img"
            aria-labelledby="achievometer-title achievometer-description"
        >
            <title id="achievometer-title">The Achievometer</title>
            <desc id="achievometer-description">
                A semicircle of colored bars from red at the start to green at
                achievement, with a needle moving toward green.
            </desc>
            <path
                class="achievometer-track"
                d="M 430 650 A 370 370 0 0 1 1170 650"
            />
            {gaugeSegments.map((segment) => (
                <path
                    class="achievometer-bar"
                    d={segment.path}
                    style={`stroke: ${segment.color}`}
                />
            ))}
            <g class="achievometer-needle">
                <line x1="800" y1="650" x2="480" y2="650" />
                <path d="M 458 650 L 490 632 L 490 668 Z" />
                <circle cx="800" cy="650" r="20" />
            </g>
            <text
                class="achievometer-label"
                x="430"
                y="724"
                text-anchor="middle"
            >
                START
            </text>
            <text
                class="achievometer-label"
                x="1170"
                y="724"
                text-anchor="middle"
            >
                ACHIEVE
            </text>
        </svg>
    </DeckSlide>
</DeckLayout>

<style>
    .week4-eyebrow::before {
        width: 22px;
    }

    .week4-byline {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 18px;
        margin: 22px 0 0;
        color: rgba(247, 251, 255, 0.78);
        font-size: 22px;
        line-height: 1.4;
    }

    .week4-byline span {
        color: var(--deck-lime);
        font-weight: 600;
    }

    .achievometer-slide {
        background:
            radial-gradient(
                ellipse at 50% 90%,
                rgba(67, 83, 163, 0.3),
                transparent 48%
            ),
            linear-gradient(115deg, #27377f 0%, #2c3e89 100%) !important;
    }

    .achievometer-copy {
        position: absolute;
        z-index: 2;
        top: 92px;
        left: 120px;
        right: 120px;
        text-align: center;
    }

    .achievometer-copy .automation-eyebrow {
        justify-content: center;
        margin-bottom: 16px;
    }

    .achievometer-copy h2 {
        margin: 0;
        color: var(--deck-white);
        font-size: 58px;
        line-height: 1.1;
    }

    .achievometer-copy > p:last-child {
        margin: 16px 0 0;
        color: rgba(247, 251, 255, 0.76);
        font-size: 26px;
        line-height: 1.35;
    }

    .achievometer-gauge {
        position: absolute;
        z-index: 1;
        bottom: 30px;
        left: 50%;
        display: block;
        width: min(1240px, 90%);
        height: auto;
        overflow: visible;
        transform: translateX(-50%);
    }

    .achievometer-track {
        fill: none;
        stroke: rgba(247, 251, 255, 0.1);
        stroke-width: 30;
    }

    .achievometer-bar {
        fill: none;
        stroke-width: 24;
        stroke-linecap: round;
    }

    :global(.achievometer-needle) {
        transform-box: view-box;
        transform-origin: 800px 650px;
    }

    :global(.achievometer-slide.present .achievometer-needle) {
        animation: achievometer-sweep 3.2s cubic-bezier(0.2, 0.75, 0.25, 1)
            350ms both;
    }

    :global(.achievometer-needle line) {
        stroke: var(--deck-white);
        stroke-width: 9;
        stroke-linecap: round;
    }

    :global(.achievometer-needle path),
    :global(.achievometer-needle circle) {
        fill: var(--deck-white);
    }

    :global(.achievometer-needle circle) {
        stroke: var(--deck-lime);
        stroke-width: 8;
    }

    .achievometer-label {
        fill: rgba(247, 251, 255, 0.8);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 22px;
        font-weight: 600;
        letter-spacing: 1px;
    }

    @keyframes achievometer-sweep {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(180deg);
        }
    }

    @media (max-width: 760px) {
        .achievometer-copy {
            top: 80px;
            left: 44px;
            right: 44px;
        }

        .achievometer-copy h2 {
            font-size: 48px;
        }

        .achievometer-copy > p:last-child {
            font-size: 22px;
        }

        .achievometer-gauge {
            bottom: 90px;
            width: 100%;
        }
    }
</style>
